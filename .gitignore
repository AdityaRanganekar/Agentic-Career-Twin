# ==========================================
# Agentic Career Twin - .gitignore
# ==========================================

# ------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------
.env
.env.*
*.env
.streamlit/secrets.toml
secrets.toml
*.pem
*.key
*.cert
*.crt

# ------------------------------------------
# Virtual Environments
# ------------------------------------------
venv/
.venv/
env/
env.bak/
venv.bak/
ENV/
BIN/

# ------------------------------------------
# Python Bytecode & Compilation
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so

# ------------------------------------------
# Package Builds & Distributions
# ------------------------------------------
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
pip-wheel-metadata/

# ------------------------------------------
# Node.js, Frontend & Web Build Artifacts
# ------------------------------------------
node_modules/
**/node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
.vite/
**/.vite/
frontend/.vite/
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo
.npm/
.eslintcache
.stylelintcache
*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
frontend/.env.local
frontend/.env.*.local
frontend/.env
coverage/
frontend/coverage/
.turbo/
.parcel-cache/
.next/
.nuxt/
out/
.vercel/

# ------------------------------------------
# Testing, Coverage & Static Analysis
# ------------------------------------------
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# ------------------------------------------
# Notebooks & ML Experiment Tracking
# ------------------------------------------
.ipynb_checkpoints/
jupyter_run_log.txt
mlruns/
mlartifacts/
wandb/
.neptune/

