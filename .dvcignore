# ==========================================
# Agentic Career Twin - .dvcignore
# Patterns of files and directories DVC should ignore.
# Improves performance and prevents accidental tracking of non-data files.
# https://dvc.org/doc/user-guide/dvcignore
# ==========================================

# ------------------------------------------
# Git & Version Control
# ------------------------------------------
.git/
.gitignore
.gitattributes
.github/

# ------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------
.env
.env.*
*.env
!.env.example
!*.env.example
!frontend/.env.example
.streamlit/secrets.toml
secrets.toml
*.pem
*.key
*.cert
*.crt

# ------------------------------------------
# Virtual Environments
# ------------------------------------------
venv/
.venv/
env/
env.bak/
venv.bak/
ENV/
BIN/

# ------------------------------------------
# Python Bytecode & Compilation
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so

# ------------------------------------------
# Package Builds & Distributions
# ------------------------------------------
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
pip-wheel-metadata/

# ------------------------------------------
# Node.js, Frontend & Web Build Artifacts
# ------------------------------------------
node_modules/
**/node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
.vite/
**/.vite/
frontend/.vite/
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo
.npm/
.eslintcache
.stylelintcache
coverage/
frontend/coverage/
.turbo/
.parcel-cache/
.next/
.nuxt/
out/
.vercel/

# ------------------------------------------
# Testing & Code Quality Caches
# ------------------------------------------
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
playwright-report/
.playwright/
test-results/

# ------------------------------------------
# Notebooks & ML Experiment Logs
# ------------------------------------------
.ipynb_checkpoints/
jupyter_run_log.txt
mlruns/
mlartifacts/
wandb/
.neptune/

# ------------------------------------------
