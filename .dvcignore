# ------------------------------------------
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*.h5
*.pkl
*.pickle
*.joblib
*.parquet
.cache/
fastembed_cache/
.fastembed/
chroma_db/
.chroma/
chroma/
vector_store/
faiss_index/

# ------------------------------------------
# Databases & Local Storage
# ------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.sqlite-shm
*.sqlite-wal
*.sqlite3-shm
*.sqlite3-wal
*.sqlite-journal
*.sqlite3-journal
career_twin.db
pgdata/
data/pgdata/
*.dump
*.sql.gz

# ------------------------------------------
# Logs & Diagnostic Traces
# ------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# User Uploads, Resumes & Scratch Files
# ------------------------------------------
uploads/
data/uploads/
data/resumes/
data/jobs/live_market_weights.json
temp/
tmp/
scratch/
*.scratch
.gemini/
.antigravity/
*.pdf
*.docx

