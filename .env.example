# ==============================================================================
# Agentic Career Twin - Backend Environment Variables
# Option A: Hugging Face Docker Spaces + Neon PostgreSQL
# ==============================================================================

# Database Connection (Neon Serverless PostgreSQL or local PostgreSQL)
# For Neon, ensure '?sslmode=require' is appended
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/career_twin?sslmode=require

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Frontend URL (For CORS whitelist and OAuth redirect resolution)
# On Vercel: https://your-project.vercel.app
# Locally: http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Google OAuth 2.0 Credentials (Optional, for Google Sign-In)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173

# Port Configuration (Defaults to 7860 on Hugging Face Spaces, 8000 locally)
PORT=7860

